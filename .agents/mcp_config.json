        "JAVA_HOME": "/Applications/Android Studio.app/Contents/jbr/Contents/Home",
        "PATH": "/Applications/Android Studio.app/Contents/jbr/Contents/Home/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
