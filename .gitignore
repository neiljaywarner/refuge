# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.firebase/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local binaries and scratch
*.apk
*.mp4
*.m4a
scratch/

# Strictly ignore all secrets, API keys, cloud configs, and PII
**/passwords.yaml
**/.scloud/
**/.firebase/
**/.env
**/.env.*
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
.worktrees/

# Strict Zero-PII: Never commit member CSV exports (only synthetic test fixture allowed)
**/*.csv
!test/fixtures/sample_anonymized_circle_export.csv
