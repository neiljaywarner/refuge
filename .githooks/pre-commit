#!/bin/sh
# Formats staged Dart files, then fails if a Belong lint rule is violated.
# Line length matches CI (100 columns, issue #519).
# Other pre-existing analyzer errors are printed and do not block the commit.
set -eu
cd "$(git rev-parse --show-toplevel)"

files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.dart$' || true)
if [ -z "$files" ]; then
  exit 0
fi

printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 dart format -l 100
printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 git add

report=$(mktemp)
dart analyze > "$report" || true
if grep -E 'no_print_use_app_logger|prefer_use_text_editing_controller|dispose_controllers' "$report"; then
  echo "Belong lint failed. Fix the diagnostics above."
  rm -f "$report"
  exit 1
fi
rm -f "$report"
