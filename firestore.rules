rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Feature Voting: Anyone can read votes; authenticated members can cast votes
    match /feature_votes/{featureId} {
      allow read: if true;
      allow write: if request.auth != null || true; // Allowed in pre-alpha for tester ease
    }

    // 2. Member Feedback (Literal 3-intent cards): Anyone can submit feedback; only authenticated admins read
    match /member_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 3. Fellowship Reflections & Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // 4. Member Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Discussion Comments & Nested Replies
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null || true;
      allow update, delete: if request.auth != null;
    }

    // 6. Admin Soft-Deleted Users Table (#356)
    match /soft_deleted_users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 7. Reflection mirror kept while Serverpod Cloud is turned off (#212).
    //    Appwrite is the other copy. Firebase Auth still signs members in.
    match /reflections/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
    match /reflections_dev/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // 8. Direct messages (#441). Kept while self-service soft delete is added.
    match /direct_messages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds;
    }

    // 9. Self-service soft delete (#544). Members may tombstone only their own
    // account. Hard delete stays closed until #545.
    match /self_deleted_accounts/{docId} {
      allow get: if request.auth != null && (
        docId == 'dev_' + request.auth.uid ||
        docId == 'stg_' + request.auth.uid ||
        docId == 'qa_' + request.auth.uid ||
        docId == 'prod_' + request.auth.uid
      );
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.softDeleted == true
        && request.resource.data.deletionKind == 'soft'
        && request.resource.data.accountStatus == 'soft_deleted'
        && request.resource.data.source == 'self_service'
        && request.resource.data.flavor in ['dev', 'stg', 'qa', 'prod']
        && docId == request.resource.data.flavor + '_' + request.auth.uid;
      allow delete: if false;
    }
  }
}
