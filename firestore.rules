rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Circle-style members-only community (#601). Guests and Firebase
    // anonymous sessions cannot read or write fellowship data. Email
    // verification stays an app-gate concern because the same Firebase
    // project serves dev example accounts and production packages.
    function isSignedInMember() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Care reactions (#662): any member may bump reaction counters on someone
    // else's post or comment. Content, author, and timestamps stay author-only.
    function isReactionOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['prayingCount', 'standingWithCount', 'peaceCount', 'encouragedCount', 'reactions'])
        && request.resource.data.get('prayingCount', 0) >= resource.data.get('prayingCount', 0)
        && request.resource.data.get('standingWithCount', 0) >= resource.data.get('standingWithCount', 0)
        && request.resource.data.get('peaceCount', 0) >= resource.data.get('peaceCount', 0)
        && request.resource.data.get('encouragedCount', 0) >= resource.data.get('encouragedCount', 0)
        && request.resource.data.get('reactions', {}) is map;
    }

    function isAuthorOf(data) {
      return request.auth.uid == data.get('authorId', null)
        || request.auth.uid == data.get('authorUid', null)
        || request.auth.uid == data.get('userId', null);
    }

    function featureVoteVoterIds(data) {
      return data.get('voterIds', []) is list ? data.get('voterIds', []) : [];
    }

    function featureVoteUpvote() {
      return request.resource.data.votes == resource.data.get('votes', 0) + 1
        && !(request.auth.uid in featureVoteVoterIds(resource.data))
        && request.auth.uid in featureVoteVoterIds(request.resource.data);
    }

    function featureVoteUnvote() {
      return request.resource.data.votes == resource.data.get('votes', 0) - 1
        && request.auth.uid in featureVoteVoterIds(resource.data)
        && !(request.auth.uid in featureVoteVoterIds(request.resource.data));
    }

    // 1. Feature Voting (#733: per-member voterIds, no blind overwrites)
    match /feature_votes/{featureId} {
      allow read: if isSignedInMember();
      allow create: if isSignedInMember()
        && request.resource.data.votes == 1
        && featureVoteVoterIds(request.resource.data).size() == 1
        && request.resource.data.voterIds[0] == request.auth.uid;
      allow update: if isSignedInMember()
        && (featureVoteUpvote() || featureVoteUnvote());
      allow delete: if false;
    }

    // 2. Member Feedback (Literal 3-intent cards)
    match /member_feedback/{feedbackId} {
      allow create: if isSignedInMember();
      allow read: if isSignedInMember()
        && (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // 3. Fellowship Reflections & Posts
    match /posts/{postId} {
      allow read, create: if isSignedInMember();
      allow update: if isSignedInMember()
        && (request.auth.uid == resource.data.get('authorId', null) || isReactionOnlyUpdate());
      allow delete: if isSignedInMember()
        && request.auth.uid == resource.data.get('authorId', null);
    }

    // 4. Member Profiles
    // Directory fields (displayName, handle, tagline, listedInDirectory)
    // live here. Never store an email address on this document.
    match /users/{userId} {
      allow read: if isSignedInMember();
      allow write: if isSignedInMember() && request.auth.uid == userId;

      // Push token stays private. The message function reads it with the admin SDK.
      match /notification_settings/{docId} {
        allow read, write: if isSignedInMember() && request.auth.uid == userId;
      }

      // Private "Save for Later" bookmarks (#669). Strictly owner-only.
      match /saved_posts/{postId} {
        allow read, write: if isSignedInMember() && request.auth.uid == userId;
      }
    }

    // 5. Discussion Comments & Nested Replies
    match /comments/{commentId} {
      allow read, create: if isSignedInMember();
      allow update: if isSignedInMember()
        && (isAuthorOf(resource.data) || isReactionOnlyUpdate());
      allow delete: if isSignedInMember() && isAuthorOf(resource.data);
    }
    // Dev builds share this Firebase project; keep their threads separate.
    match /comments_dev/{commentId} {
      allow read, create: if isSignedInMember();
      allow update: if isSignedInMember()
        && (isAuthorOf(resource.data) || isReactionOnlyUpdate());
      allow delete: if isSignedInMember() && isAuthorOf(resource.data);
    }

    // 6. Admin Soft-Deleted Users Table (#356)
    match /soft_deleted_users/{userId} {
      allow read: if isSignedInMember();
      allow write: if isSignedInMember() && request.auth.token.email != null;
    }

    // 7. Reflection mirror kept while Serverpod Cloud is turned off (#212).
    match /reflections/{postId} {
      allow read, create: if isSignedInMember();
      allow update: if isSignedInMember()
        && (request.auth.uid == resource.data.get('authorId', null) || isReactionOnlyUpdate());
      allow delete: if isSignedInMember()
        && request.auth.uid == resource.data.get('authorId', null);
    }
    match /reflections_dev/{postId} {
      allow read, create: if isSignedInMember();
      allow update: if isSignedInMember()
        && (request.auth.uid == resource.data.get('authorId', null) || isReactionOnlyUpdate());
      allow delete: if isSignedInMember()
        && request.auth.uid == resource.data.get('authorId', null);
    }

    // 8. Direct messages (#441)
    match /direct_messages/{messageId} {
      allow read: if isSignedInMember()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedInMember()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds;
    }

    // 9. Member directory used by the direct-message picker.
    // Documents store a public name and plus-tag handle, never an email.
    match /directory_members/{userId} {
      allow read: if isSignedInMember();
      allow create, update, delete: if isSignedInMember()
          && request.auth.uid == userId;
    }

    // 10. Cross-account bell items (direct messages and @-mentions).
    match /member_notifications/{notificationId} {
      allow read: if isSignedInMember()
          && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedInMember()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientUid != request.auth.uid;
      allow update: if isSignedInMember()
          && resource.data.recipientUid == request.auth.uid;
    }

    // 11. Self-service soft delete (#544). Members may tombstone only their own
    // account. Hard delete stays closed until #545.
    match /self_deleted_accounts/{docId} {
      allow get: if isSignedInMember() && (
        docId == 'dev_' + request.auth.uid ||
        docId == 'stg_' + request.auth.uid ||
        docId == 'qa_' + request.auth.uid ||
        docId == 'prod_' + request.auth.uid
      );
      allow list: if false;
      allow create, update: if isSignedInMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.softDeleted == true
        && request.resource.data.deletionKind == 'soft'
        && request.resource.data.accountStatus == 'soft_deleted'
        && request.resource.data.source == 'self_service'
        && request.resource.data.flavor in ['dev', 'stg', 'qa', 'prod']
        && docId == request.resource.data.flavor + '_' + request.auth.uid;
      allow delete: if false;
    }
  }
}
